{
  "name": "@fungi.computer/bonsai",
  "version": "0.3.0",
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "release": "node scripts/release.mjs",
    "rebuild-copies": "node --import tsx scripts/rebuild-copies.mjs",
    "seed:demo": "node --import tsx scripts/seed-demo.mjs"
  },
  "dependencies": {
    "@fungi.computer/agar": "0.6.0",
    "@fungi.computer/caps": "0.5.0",
    "@fungi.computer/issues": "0.2.0",
    "@fungi.computer/oyster": "0.7.0",
    "@fungi.computer/puffball": "0.3.0",
    "@fungi.computer/sigils": "0.2.0",
    "@fungi.computer/stipe": "0.1.0",
    "@pierre/diffs": "1.3.6",
    "@pierre/trees": "1.0.0-beta.6",
    "@tanstack/react-query": "5.102.8",
    "@visx/curve": "3.12.0",
    "@visx/scale": "3.12.0",
    "@visx/shape": "3.12.0",
    "diff": "9.0.0",
    "lucide-react": "0.460.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "4.4.3",
    "@fungi.computer/watchdog": "0.1.0",
    "effect": "4.0.2",
    "@fungi.computer/cairn": "0.1.0",
    "@fungi.computer/maosaico": "0.1.0",
    "@visx/hierarchy": "3.12.0",
    "@fungi.computer/gills": "0.2.0",
    "@fungi.computer/nacre": "0.1.1",
    "@fungi.computer/trellis": "0.5.0",
    "@fungi.computer/braid": "0.3.0",
    "@fungi.computer/workflows-wire": "0.3.0"
  },
  "devDependencies": {
    "playwright": "1.62.1",
    "@cloudflare/workers-types": "5.20260828.1",
    "@tailwindcss/vite": "4.2.1",
    "@types/node": "24.13.3",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.3",
    "@vitejs/plugin-react": "6.1.1",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wrangler": "4.135.0",
    "tsx": "4.23.12",
    "@fungi.computer/gills": "0.2.0",
    "eslint": "10.9.1",
    "oxlint": "1.78.0",
    "jsdom": "29.0.1",
    "@fungi.computer/computer-contract": "0.0.6",
    "@tailwindcss/cli": "4.2.1"
  },
  "fungi": {
    "build": {
      "stylesheets": [
        "web/bonsai.css"
      ],
      "react": true,
      "packageStylesheets": [
        "@fungi.computer/caps"
      ],
      "entry": "web/index.html",
      "maxOutputBytes": 67108864,
      "backend": {
        "entry": "backend/index.ts",
        "exportName": "BonsaiApp",
        "compatibilityDate": "2026-09-04",
        "runtime": {
          "kind": "durable-facet",
          "stateSchema": 1
        }
      },
      "assetBase": "./",
      "assets": {
        "maxManifestBytes": 1048576,
        "maxObjects": 1024,
        "maxObjectBytes": 16777216,
        "maxTotalBytes": 67108864
      }
    },
    "backendDefinition": "backend/methods.ts",
    "app": {
      "displayName": "Bonsai",
      "icon": "bonsai",
      "capabilities": [
        "git.repository",
        "apps.open",
        "app.events.emit",
        "computer.execute",
        "workflow.run",
        "workflow.publish"
      ],
      "receives": [
        "git.push"
      ],
      "handlers": [],
      "roles": [],
      "backend": {
        "bindings": [
          {
            "name": "GIT",
            "operations": [
              "create",
              "fork",
              "read",
              "write",
              "exchange"
            ]
          },
          {
            "name": "EVENTS",
            "operations": [
              "emit"
            ]
          },
          {
            "name": "APPS",
            "operations": [
              "register",
              "fork",
              "build",
              "buildStatus",
              "select",
              "repository"
            ]
          },
          {
            "name": "WORKFLOWS",
            "operations": [
              "catalog",
              "runGraph",
              "graphStatus",
              "runs"
            ]
          }
        ]
      }
    }
  },
  "author": "Levi <levi@technomancy.dev>",
  "type": "module",
  "description": "Bonsai: a git platform for many agents working at once, on Workers and Artifacts",
  "botanical": {
    "role": "app",
    "operations": {
      "lint": "required",
      "typecheck": "required",
      "build": "required",
      "test": "required",
      "docs": {
        "status": "not-applicable",
        "reason": "Bonsai documents itself in its README; it has no package API"
      },
      "pack": {
        "status": "not-applicable",
        "reason": "Bonsai deploys as a Worker, not an npm package"
      },
      "smoke": {
        "status": "not-applicable",
        "reason": "The preview deployment and browser shots exercise Bonsai"
      },
      "stranger": {
        "status": "not-applicable",
        "reason": "Bonsai is not yet published"
      }
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fungi-computer/bonsai.git"
  },
  "packageManager": "pnpm@11.24.0"
}
